# build/, frontend/wailsjs resta per go vet e go test. Non devono mai finire
# in un commit. L'interfaccia (HTML/CSS/JS senza passo di build) sta in
# frontend/ui.
build/
frontend/wailsjs/
*.log
.DS_Store

